<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN">

	<Appenders>
		<!-- Console output -->
		<Console name="Console" target="SYSTEM_OUT">
			<PatternLayout
				pattern="%d{yyyy-MM-dd HH:mm:ss} %-5level %c{1} - %msg%n" />
		</Console>

		<!-- File output -->
		<File name="FileLogger" fileName="logs/application.log" append="true">
			<!--Exclude error and fatal logs from application.log file-->
			<Filters>
				<ThresholdFilter level="ERROR"
					onMatch="DENY"
					onMismatch="ACCEPT" />
			</Filters>
			<PatternLayout>
				<Pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level %c{1} - %msg%n</Pattern>
			</PatternLayout>
		</File>

		<File name="ErrorFileLogger" fileName="logs/error.log" append="true">
			<!--include error and fatal logs from application.log file-->
			<Filters>
				<ThresholdFilter level="ERROR"
					onMatch="ACCEPT"
					onMismatch="DENY" />
			</Filters>
			<PatternLayout>
				<Pattern>%d{yyyy-MM-dd HH:mm:ss} %-5level %c{1} - %msg%n</Pattern>
			</PatternLayout>
		</File>
	</Appenders>

	<Loggers>
		<!-- Root logger -->
		<Root level="info">
			<AppenderRef ref="Console" />
			<AppenderRef ref="FileLogger" />
		</Root>

		<!-- Rest Assured specific logging -->
		<Logger name="com.hrm" level="trace" additivity="false">
			<AppenderRef ref="Console" />
			<AppenderRef ref="FileLogger" />
			<AppenderRef ref="ErrorFileLogger" />
		</Logger>

		<!-- Apache HTTP client (optional) -->
		<Logger name="org.apache.http" level="warn" additivity="false">
			<AppenderRef ref="Console" />
		</Logger>
	</Loggers>

</Configuration>
